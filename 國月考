<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>國小語文趣味闖關測驗（大字版與語音朗讀）</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Noto Sans TC Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans TC', 'Inter', sans-serif;
        }
    </style>
</head>
<body id="main-body" class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen text-slate-800 py-8 px-4 sm:px-6 transition-all duration-300" style="font-size: 1.2rem;">

    <div class="max-w-4xl mx-auto">
        <!-- 頂部標題列與控制工具列 -->
        <header class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl p-6 mb-8 border border-indigo-100 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-center md:text-left">
                <div class="inline-block bg-indigo-100 text-indigo-700 text-sm font-bold px-4 py-1.5 rounded-full mb-2 shadow-sm">
                    📚 國小語文能力檢測（大字無障礙版）
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-indigo-900 tracking-tight">趣味語文互動測驗</h1>
            </div>

            <!-- 字體大小調整與全頁朗讀控制按鈕 -->
            <div class="flex flex-wrap items-center justify-center gap-2 bg-indigo-50/80 p-3 rounded-xl border border-indigo-100">
                <span class="text-xs sm:text-sm font-bold text-indigo-800 mr-1">字體大小：</span>
                <button onclick="adjustFontSize(-2)" class="bg-white hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-lg shadow-sm border border-indigo-200 transition cursor-pointer text-sm" title="縮小字體">
                    A- 縮小
                </button>
                <button onclick="resetFontSize()" class="bg-white hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-lg shadow-sm border border-indigo-200 transition cursor-pointer text-sm" title="預設大小">
                    預設
                </button>
                <button onclick="adjustFontSize(2)" class="bg-white hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-lg shadow-sm border border-indigo-200 transition cursor-pointer text-sm" title="放大字體">
                    A+ 放大
                </button>
                <div class="h-6 w-px bg-indigo-200 mx-1"></div>
                <button onclick="speakFullQuiz()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-1.5 rounded-lg shadow-sm transition flex items-center gap-1.5 cursor-pointer text-sm">
                    <span>🔊 朗讀全部題目</span>
                </button>
                <button onclick="stopSpeech()" class="bg-rose-500 hover:bg-rose-600 text-white font-bold px-3 py-1.5 rounded-lg shadow-sm transition cursor-pointer text-sm" title="停止聲音">
                    ⏹ 停止
                </button>
            </div>
        </header>

        <!-- 測驗內容表單容器 -->
        <main id="quiz-container" class="space-y-6">
            <!-- 題目會由 JavaScript 動態填入 -->
        </main>

        <!-- 底部提交與統計區 -->
        <div class="mt-8 bg-white/95 backdrop-blur-md rounded-2xl shadow-xl p-6 text-center border border-indigo-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div id="score-display" class="text-lg font-bold text-slate-700">
                尚未交卷 🎯
            </div>
            <div class="flex gap-3 w-full sm:w-auto">
                <button onclick="submitQuiz()" class="flex-1 sm:flex-none bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition duration-200 transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer text-lg">
                    交卷看成績 📝
                </button>
                <button onclick="resetQuiz()" class="flex-1 sm:flex-none bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold py-3 px-6 rounded-xl transition duration-200 cursor-pointer text-lg">
                    重新作答 🔄
                </button>
            </div>
        </div>
    </div>

    <!-- 自訂訊息對話框 (替代 alert) -->
    <div id="modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl text-center transform transition-all">
            <div id="modal-icon" class="text-4xl mb-3">🎉</div>
            <h3 id="modal-title" class="text-xl font-bold text-slate-800 mb-2">測驗結果</h3>
            <p id="modal-message" class="text-slate-600 mb-6 leading-relaxed">恭喜完成測驗！</p>
            <button onclick="closeModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl w-full shadow-md transition duration-200 cursor-pointer">
                我知道了
            </button>
        </div>
    </div>

    <script>
        // 題目資料設定
        const questions = [
            {
                id: 1,
                question: "仲仲看完新學年新希望後，覺得課文中的「我」觀察力很好，仲仲為何這麼說？",
                options: [
                    "「我」對生活有豐富的情感感受。",
                    "「我」喜歡看書，也常常鼓勵同學。",
                    "「我」對於每位同學富有同情心。",
                    "「我」會發現生活中的各種改變。"
                ],
                answer: 0
            },
            {
                id: 2,
                question: "第六課中提到，柿餅節時到新埔玩，遊客除了可以買柿餅送給親朋好友，還可以品嘗什麼菜色？",
                options: [
                    "日本拉麵",
                    "四川麻辣鍋",
                    "客家菜",
                    "越南春捲。"
                ],
                answer: 2
            },
            {
                id: 3,
                question: "坐竹籃船一課中，主角和家人坐竹籃船的活動地點在哪裡？",
                options: [
                    "近海",
                    "水庫裡",
                    "高速公路上",
                    "草地上。"
                ],
                answer: 1
            },
            {
                id: 4,
                question: "「秋風和陽光，會把柿子慢慢風乾。」由此可見，當地的秋風和陽光有什麼特色？",
                options: [
                    "寒冷又潮溼",
                    "溫度高又潮濕",
                    "寒冷又乾燥",
                    "溫度高又乾燥。"
                ],
                answer: 2
            },
            {
                id: 5,
                question: "哪個選項的組成方式和「淡淡的書香」相同？",
                options: [
                    "覺得好傷心",
                    "站在燈光下",
                    "快快的寫作業",
                    "柔柔的月光。"
                ],
                answer: 3
            },
            {
                id: 6,
                question: "下面哪一組字的部首相同？",
                options: [
                    "叔／如",
                    "書／畫",
                    "全／臉",
                    "鄉／聲。"
                ],
                answer: 1
            },
            {
                id: 7,
                question: "下面句子的空格中，哪一個適合填入「不過」？",
                options: [
                    "媽媽不但會唱歌，□□還會跳舞。",
                    "雖然他努力複習，□□還是考不好。",
                    "晚上八點時，哥哥□□看電視。",
                    "請把燈打開，□□光線不夠充足。"
                ],
                answer: 1
            },
            {
                id: 8,
                question: "「大家同心□□，終於完成這項工作。」空格中不適合填入哪個詞？",
                options: [
                    "齊力",
                    "協力",
                    "用力",
                    "合力。"
                ],
                answer: 2
            },
            {
                id: 9,
                question: "「我□學圍棋，□□學跳舞。」空格中應該填入下面哪一組關聯詞？",
                options: [
                    "一，就要",
                    "要，還要",
                    "也，還是",
                    "是，也是。"
                ],
                answer: 1
            },
            {
                id: 10,
                question: "「老師喜歡香水□尤其是玫瑰□依蘭花□蓮花和月桂葉的味道。」句中三個□依序應該填入哪些標點符號？",
                options: [
                    "、 、 、",
                    "， 、 、",
                    "。 ！，",
                    "？ 、 ，"
                ],
                answer: 1
            }
        ];

        const optionLabels = ["①", "②", "③", "④"];
        let currentFontSize = 1.2; // 預設 1.2rem，比原本更大更清楚

        // 頁面載入時渲染題目
        window.onload = function() {
            renderQuiz();
        };

        // 字體大小動態調整
        function adjustFontSize(step) {
            currentFontSize += step * 0.1;
            if (currentFontSize < 1.0) currentFontSize = 1.0; // 最小限制
            if (currentFontSize > 2.0) currentFontSize = 2.0; // 最大限制
            document.body.style.fontSize = currentFontSize + 'rem';
        }

        function resetFontSize() {
            currentFontSize = 1.2;
            document.body.style.fontSize = currentFontSize + 'rem';
        }

        // 渲染測驗介面
        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            let html = '';

            questions.forEach((q, qIndex) => {
                let optionsHtml = '';
                q.options.forEach((opt, optIndex) => {
                    const fullOptText = `${optionLabels[optIndex]} ${opt}`;
                    optionsHtml += `
                        <label class="flex items-center justify-between p-4 rounded-2xl border-2 border-slate-200 hover:border-indigo-400 hover:bg-indigo-50/60 transition cursor-pointer group shadow-sm">
                            <div class="flex items-center space-x-3.5 flex-1">
                                <input type="radio" name="question-${qIndex}" value="${optIndex}" class="w-5 h-5 text-indigo-600 focus:ring-indigo-500 cursor-pointer">
                                <span class="text-slate-800 font-semibold group-hover:text-indigo-900 leading-relaxed">${fullOptText}</span>
                            </div>
                            <button type="button" onclick="speakText('${escapeHtml(fullOptText)}')" class="p-2.5 text-indigo-600 hover:text-indigo-800 hover:bg-indigo-100 rounded-full transition shadow-sm ml-2 flex-shrink-0" title="朗讀選項">
                                <span class="text-xl">🔊</span>
                            </button>
                        </label>
                    `;
                });

                html += `
                    <div class="bg-white rounded-3xl shadow-lg p-6 sm:p-8 border-2 border-indigo-50 transition hover:shadow-xl">
                        <div class="flex items-start justify-between gap-4 mb-5">
                            <div class="flex items-start space-x-3.5 flex-1">
                                <span class="bg-indigo-600 text-white font-black text-base px-3 py-1 rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">${q.id}</span>
                                <h3 class="font-bold text-slate-900 leading-relaxed">${q.question}</h3>
                            </div>
                            <button type="button" onclick="speakText('${escapeHtml(q.question)}')" class="p-3 text-indigo-700 hover:text-indigo-900 hover:bg-indigo-100 rounded-2xl transition flex-shrink-0 shadow-sm bg-indigo-50/80 border border-indigo-100 flex items-center gap-1 font-bold" title="朗讀題目">
                                <span class="text-2xl">🔊</span>
                                <span class="text-xs hidden sm:inline">讀題目</span>
                            </button>
                        </div>
                        <div class="space-y-3 pl-0 sm:pl-12">
                            ${optionsHtml}
                        </div>
                        <div id="feedback-${qIndex}" class="mt-4 font-bold pl-0 sm:pl-12 hidden"></div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // 瀏覽器內建中文語音合成朗讀功能
        function speakText(text) {
            if (!('speechSynthesis' in window)) {
                showModal("提示", "您的瀏覽器不支援語音朗讀功能，請使用最新版本的 Chrome 或 Edge 瀏覽器。", "⚠️");
                return;
            }

            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'zh-TW';
            utterance.rate = 0.85; // 放慢速度，更適合國小與資源班學生聆聽
            window.speechSynthesis.speak(utterance);
        }

        // 全頁連續朗讀功能（依序朗讀所有題目與選項）
        function speakFullQuiz() {
            if (!('speechSynthesis' in window)) {
                showModal("提示", "您的瀏覽器不支援語音朗讀功能。", "⚠️");
                return;
            }
            window.speechSynthesis.cancel();

            let fullText = "開始朗讀測驗題目。";
            questions.forEach((q, qIndex) => {
                fullText += `第 ${qIndex + 1} 題：${q.question}。選項有：`;
                q.options.forEach((opt, optIndex) => {
                    fullText += `${optionLabels[optIndex]}，${opt}。`;
                });
            });
            fullText += "朗讀完畢。";

            const utterance = new SpeechSynthesisUtterance(fullText);
            utterance.lang = 'zh-TW';
            utterance.rate = 0.85;
            window.speechSynthesis.speak(utterance);
        }

        function stopSpeech() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
        }

        // 提交測驗與計算成績
        function submitQuiz() {
            let score = 0;
            let answeredCount = 0;

            questions.forEach((q, qIndex) => {
                const selectedRadio = document.querySelector(`input[name="question-${qIndex}"]:checked`);
                const feedbackEl = document.getElementById(`feedback-${qIndex}`);
                feedbackEl.classList.remove('hidden');

                if (selectedRadio) {
                    answeredCount++;
                    const selectedVal = parseInt(selectedRadio.value);
                    if (selectedVal === q.answer) {
                        score += 10;
                        feedbackEl.innerHTML = `<span class="text-emerald-700 bg-emerald-50 px-4 py-2 rounded-xl inline-flex items-center gap-2 border border-emerald-200">✅ 答對了！</span>`;
                    } else {
                        feedbackEl.innerHTML = `<span class="text-rose-700 bg-rose-50 px-4 py-2 rounded-xl inline-flex items-center gap-2 border border-rose-200">❌ 答錯了，正確答案是：${optionLabels[q.answer]} ${q.options[q.answer]}</span>`;
                    }
                } else {
                    feedbackEl.innerHTML = `<span class="text-amber-700 bg-amber-50 px-4 py-2 rounded-xl inline-flex items-center gap-2 border border-amber-200">⚠️ 本題尚未作答！正確答案是：${optionLabels[q.answer]} ${q.options[q.answer]}</span>`;
                }
            });

            document.getElementById('score-display').innerHTML = `測驗已完成！得分：<span class="text-indigo-600 font-black text-2xl">${score}</span> 分（已答 ${answeredCount}/10 題）`;

            let icon = "🎉";
            let msg = `恭喜完成測驗！您的總分是 ${score} 分。`;
            if (score === 100) {
                msg = `太棒了！獲得 100 分滿分！表現非常優秀！🌟`;
            } else if (score >= 60) {
                msg = `表現不錯！總分獲得 ${score} 分，繼續加油！👍`;
            } else {
                msg = `再接再厲！總分獲得 ${score} 分，多聽幾次題目再挑戰一次吧！💪`;
            }
            showModal("成績結算", msg, icon);
        }

        // 重新作答重置
        function resetQuiz() {
            stopSpeech();
            renderQuiz();
            document.getElementById('score-display').innerHTML = "尚未交卷 🎯";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 輔助函式：逸出單引號避免字串中斷
        function escapeHtml(str) {
            return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
        }

        // 彈出視窗控制
        function showModal(title, message, icon) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerText = message;
            document.getElementById('modal-icon').innerText = icon;
            const modal = document.getElementById('modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }
    </script>
</body>
</html>
